# Copy this file to .env (in the project root) and fill in real values.
# .env is gitignored and must never be committed.
# The app checks real environment variables first (for hosting), then
# ./.env, then ../.env (one folder up).

# Primary: course-provided Portkey gateway key (model: gpt-6-luna)
PORTKEY_API_KEY=

# Fallback: direct OpenAI key, used only if PORTKEY_API_KEY is not set
OPENAI_API_KEY=

# Set to "production" on the host. Production turns off dev-only routes (/api/debug/*), requires
# APP_SECRET_KEY, and reads settings ONLY from real environment variables (any .env file is ignored).
# On Render these and the variables below are set in the dashboard; see README.md.
APP_ENV=development

# Signs sign-in tokens. Required in production; any long random string, e.g. the output of:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=

# Required: the Postgres database (a free Neon project in production; locally, a Neon branch or any Postgres).
# e.g. postgresql://user:password@host/dbname?sslmode=require   (it holds a password: never commit it)
DATABASE_URL=

# The site's public address. The Google / Microsoft redirect URIs are built from it:
#   <PUBLIC_BASE_URL>/api/auth/google/callback and <PUBLIC_BASE_URL>/api/auth/microsoft/callback
# Locally, http://localhost:8000 (or leave blank to use the address the request came in on).
PUBLIC_BASE_URL=

# "Continue with Google" / "Continue with Microsoft". A provider without both values is simply hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Tests only (optional): a Postgres server the test suite may create and drop databases on. Without it the tests
# use the portable PostgreSQL in backend/.pg (backend/scripts/get_test_postgres.py).
TEST_DATABASE_ADMIN_URL=
