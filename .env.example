# Copy this file to .env (in the project root) and fill in real values.
# .env is gitignored and must never be committed.
# The app checks real environment variables first (for hosting), then
# ./.env, then ../.env (one folder up).

# Primary: course-provided Portkey gateway key (model: gpt-6-luna)
PORTKEY_API_KEY=

# Fallback: direct OpenAI key, used only if PORTKEY_API_KEY is not set
OPENAI_API_KEY=

# Set to "production" on the host to turn off dev-only routes (/api/debug/*)
APP_ENV=development
