# Secrets: never commit. Copy .env.example to .env and fill in your own keys.
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.pyc

# Node / Vite
node_modules/
dist/
*.local

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# SQLite scratch files
*.db-journal
*.db-wal
*.db-shm

# The working database (accounts, logs, calendars) is created at startup from the committed, clean
# backend/app/db/homebase_original.db. Never commit it: it can hold real people's data.
backend/app/db/homebase.db
