# Secrets: never commit. Copy .env.example to .env and fill in your own keys.
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.pyc

# Node / Vite
node_modules/
dist/
*.local

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# The data lives in Postgres (DATABASE_URL) since 2026-10-25. Old SQLite files (a local homebase.db, or one downloaded
# from the old Render disk for app/db/import_sqlite.py) hold real people's data: never commit them.
*.db
*.db-journal
*.db-wal
*.db-shm

# Review export: rebuilt any time by backend/scripts/export_exercise_review.py
content/exercise_review_export.xlsx

# Portable PostgreSQL for the local test suite (downloaded by backend/scripts/get_test_postgres.py; never committed)
backend/.pg/
